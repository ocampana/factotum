# --- Mistral ---
MISTRAL_API_KEY=
# MISTRAL_LLM_MODEL=mistral-small-latest
# MISTRAL_STT_MODEL=voxtral-mini-latest
# MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
# TTS voices: if not set, at startup factotum lists the available voices
# (/v1/audio/voices) and picks, for each language, the first voice declaring it.
# MISTRAL_TTS_VOICE=<fallback voice_id>
# MISTRAL_TTS_VOICES=it:<voice_id>,de:<voice_id>

# --- SIP (any SIP server) ---
SIP_SERVER=192.168.1.1
SIP_USER=
SIP_PASSWORD=
# SIP_PORT=5060
# SIP_TRANSPORT=udp
# SIP_DOMAIN=
# SIP_OUTBOUND_PROXY=
# SIP_CODECS=PCMA,PCMU
# SIP_STUN=
# SIP_PLUS_REPLACEMENT=00

# --- Web and users ---
FACTOTUM_ADMIN_USER=admin
FACTOTUM_ADMIN_PASSWORD=
# Secret used to sign session cookies (generate with: python -c "import secrets;print(secrets.token_hex(32))")
FACTOTUM_SECRET=
# Authentication providers: local, ha_ingress, api_token (comma separated)
# FACTOTUM_AUTH=local
# FACTOTUM_API_TOKEN=
# FACTOTUM_HA_TRUSTED_PROXIES=172.30.32.2
# FACTOTUM_WEB_PORT=8080
# FACTOTUM_DATA_DIR=./data
# FACTOTUM_DEFAULT_COUNTRY_CODE=39
# FACTOTUM_SUMMARY_LANGUAGE=English

# --- Google (optional) ---
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json

TZ=Europe/Rome
# LOG_LEVEL=INFO
